{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/pre-pr-verify.sh\"",
            "timeout": 600,
            "statusMessage": "Verifying before opening the PR..."
          }
        ]
      }
    ]
  }
}
