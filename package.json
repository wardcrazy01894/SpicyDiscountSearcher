{
  "name": "spicy-discount-searcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome/Brave extension that races corporate discount codes against each other to find the cheapest rental car or hotel rate.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:content",
    "build:main": "tsc --noEmit && vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codes": "./scripts/extract_codes.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/chrome": "^0.0.278",
    "@types/node": "^22.7.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
